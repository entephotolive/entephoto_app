<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Application theme ──────────────────────────────────────── -->
    <style name="Theme.entephoto" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dim</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/success_accent</item>
        <item name="colorSecondaryVariant">@color/success_surface</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error_accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- ── Toolbar overlay ────────────────────────────────────────── -->
    <style name="ThemeOverlay.MaterialComponents.Dark.ActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <!-- ── Typography ─────────────────────────────────────────────── -->
    <style name="TextAppearance.entephoto.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.entephoto.StatusTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.entephoto.StatusDetail" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.entephoto.ErrorTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.entephoto.ErrorBody" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
    </style>

</resources>
