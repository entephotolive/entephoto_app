<?xml version="1.0" encoding="utf-8"?>
<!--
    Page 1 — Connection Screen
    Shows camera connection status and, critically, the blocking PC Remote
    error panel when the camera is in the wrong USB mode.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ── Toolbar ─────────────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_dark"
            app:title="@string/app_name"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/TextAppearance.entephoto.Toolbar" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Scrollable body ─────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- ── Status card (always visible) ──────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:gravity="center">

                    <!-- Animated USB icon -->
                    <ImageView
                        android:id="@+id/ivUsbIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginBottom="20dp"
                        android:src="@drawable/ic_usb_import"
                        android:tint="@color/accent_blue"
                        android:contentDescription="@string/cd_usb_icon" />

                    <!-- Primary status label -->
                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/status_waiting"
                        android:textAppearance="@style/TextAppearance.entephoto.StatusTitle"
                        android:textColor="@color/text_primary"
                        android:gravity="center" />

                    <!-- Secondary detail label -->
                    <TextView
                        android:id="@+id/tvStatusDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_detail_waiting"
                        android:textAppearance="@style/TextAppearance.entephoto.StatusDetail"
                        android:textColor="@color/text_secondary"
                        android:gravity="center" />

                    <!-- Progress indicator (shown while Connecting) -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressConnecting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/accent_blue"
                        app:trackColor="@color/surface_stroke"
                        app:trackThickness="3dp"
                        app:indicatorSize="40dp"
                        style="@style/Widget.Material3.CircularProgressIndicator" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── "Connection help" text button (always visible) ────────── -->
            <!--
                Tapping this opens ConnectionGuideActivity from any state of
                the waiting screen.  The guide also auto-opens on first launch
                (MainActivity.onCreate checks GuidePreferences.hasSeenGuide).
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnectionHelp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp"
                android:text="@string/btn_connection_help"
                android:textColor="@color/accent_blue"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiagnosticTest"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:text="🧪 STEP 1: PTP TRANSPORT TEST"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                app:strokeColor="@color/accent_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiagnosticSdio"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:text="⚡ STEP 2: SDIO HANDSHAKE TEST"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                app:strokeColor="@color/accent_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiagnosticShutter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="📷 STEP 3: SHUTTER FIRE TEST"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                app:strokeColor="@color/accent_blue" />


            <!--
                This is the hard-block described in Step 2.  When visible, the
                user CANNOT proceed — they must unplug, change the camera menu
                (Menu → Setup → USB Connection → MTP), and re-plug.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPcRemoteError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/error_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/error_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/ic_warning"
                        android:tint="@color/error_accent"
                        android:contentDescription="@string/cd_warning_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/error_pc_remote_title"
                        android:textAppearance="@style/TextAppearance.entephoto.ErrorTitle"
                        android:textColor="@color/error_accent"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvPcRemoteBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="@string/error_pc_remote_body"
                        android:textAppearance="@style/TextAppearance.entephoto.ErrorBody"
                        android:textColor="@color/text_on_error"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4" />

                    <!-- Instruction steps -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/error_steps_bg"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/error_pc_remote_step1"
                                android:textColor="@color/text_on_error"
                                android:textSize="13sp"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/error_pc_remote_step2"
                                android:textColor="@color/text_on_error"
                                android:textSize="13sp"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/error_pc_remote_step3"
                                android:textColor="@color/text_on_error"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Camera info card (VISIBLE only when Connected) ──────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCameraInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/success_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/success_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/ic_check_circle"
                        android:tint="@color/success_accent"
                        android:contentDescription="@string/cd_connected_icon" />

                    <TextView
                        android:id="@+id/tvCameraModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="—"
                        android:textColor="@color/success_accent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvCameraStorages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Permission denied card ──────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissionDenied"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/warn_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/warn_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/error_permission_denied_title"
                        android:textColor="@color/warn_accent"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/error_permission_denied_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Website footer ───────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvFooterWebsite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/website_domain"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
