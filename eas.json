{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false",
        "EXPO_PUBLIC_API_URL": "https://staging.entephoto.co.in/api",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1063508208560-doiqsb7e3glfcr2n6cdc87dr5hj256gd.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "1063508208560-hkutc2lvq63mqa0rg3onha67vsgtisev.apps.googleusercontent.com",
        "EXPO_PUBLIC_PHOTO_STORAGE_PATH": "Download",
        "EXPO_PUBLIC_PHOTO_ALBUM_NAME": "Entephoto"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
